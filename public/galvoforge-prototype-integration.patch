+function createBedGridTexture(maxAnisotropy: number): THREE.CanvasTexture {
+  const canvas = document.createElement('canvas');
+  canvas.width = 1024;
+  canvas.height = 1024;
+  const ctx = canvas.getContext('2d')!;
+
+  ctx.fillStyle = '#0f172a';
+  ctx.fillRect(0, 0, 1024, 1024);
+
+  ctx.strokeStyle = '#334155';
+  ctx.lineWidth = 8;
+  ctx.strokeRect(32, 32, 960, 960);
+
+  ctx.strokeStyle = 'rgba(56, 189, 248, 0.14)';
+  ctx.lineWidth = 1.5;
+  const step = 960 / 20;
+  for (let i = 0; i <= 20; i++) {
+    const p = 32 + i * step;
+    ctx.beginPath();
+    ctx.moveTo(p, 32);
+    ctx.lineTo(p, 992);
+    ctx.stroke();
+
+    ctx.beginPath();
+    ctx.moveTo(32, p);
+    ctx.lineTo(992, p);
+    ctx.stroke();
+  }
+
+  ctx.strokeStyle = 'rgba(6, 182, 212, 0.45)';
+  ctx.lineWidth = 3;
+  ctx.beginPath();
+  ctx.moveTo(512, 32);
+  ctx.lineTo(512, 992);
+  ctx.moveTo(32, 512);
+  ctx.lineTo(992, 512);
+  ctx.stroke();
+
+  ctx.strokeStyle = 'rgba(244, 63, 94, 0.35)';
+  ctx.lineWidth = 2.5;
+  [160, 320, 440].forEach((r) => {
+    ctx.beginPath();
+    ctx.arc(512, 512, r, 0, Math.PI * 2);
+    ctx.stroke();
+  });
+
+  ctx.fillStyle = '#94a3b8';
+  ctx.font = '600 22px "JetBrains Mono", monospace';
+  ctx.fillText('DESCENDING Z-BED PLATFORM (100x100mm)', 52, 72);
+  ctx.fillText('+Y', 524, 68);
+  ctx.fillText('+X', 940, 502);
+
+  const tex = new THREE.CanvasTexture(canvas);
+  tex.colorSpace = THREE.SRGBColorSpace;
+  tex.anisotropy = maxAnisotropy;
+  return tex;
